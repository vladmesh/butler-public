# Butler bridge configuration. Copy to .env and fill in. No defaults for secrets.
BUTLER_TG_TOKEN=
BUTLER_ADMIN_ID=
GROQ_API_KEY=
OPENROUTER_API_KEY=
BUTLER_WORKDIR=/home/dev/butler
BUTLER_CLAUDE_MODEL=opus
BUTLER_CLAUDE_EFFORT=medium
BUTLER_CODEX_MODEL=gpt-5.6-terra
BUTLER_CODEX_EFFORT=high
BUTLER_HEAD_TIMEOUT_S=900
# Служебный тёрн перед ротацией (перенос дайджеста, памяти и «Выучено» в новую сессию).
# Свой предел времени, заметно меньше основного: этот тёрн стоит между сообщением
# владельца и ответом на него, поэтому его ждут молча. Сорвался — ротация откладывается
# до следующего сообщения, на третий срыв подряд сессия ротируется без него.
# Значение измерено, а не подобрано: удавшиеся переносы заняли 104 с (14.08), 126 с
# (15.08) и 141 с (20.08, дайджест 19 КБ), сорвавшийся 20.08 не уложился в прежние 180 с.
# Тёрн растёт вместе с дайджестом, поэтому предел взят с запасом чуть больше двойного
# от самого долгого удавшегося. Длительности пишет `service_turn_done duration_s`.
BUTLER_SERVICE_TURN_TIMEOUT_S=300
# Остановка по SIGTERM: сколько ждать, пока идущий тёрн договорит и его ответ уйдёт
# владельцу. Новые сообщения после сигнала не принимаются, оставшиеся в очереди уходят
# в долг и уезжают владельцу первой строкой после перезапуска. Порог истёк — голову
# убиваем, в лог идёт shutdown_forced. TimeoutStopSec в packaging/butler.service должен
# быть больше этого значения (сейчас 330 при 300), иначе systemd прибьёт мост раньше,
# чем тот успеет договорить; меняешь здесь — меняй и там.
BUTLER_SHUTDOWN_GRACE_S=300
# Ротация сессии: два независимых порога, срабатывает тот, до которого дошли первым.
# Тёрны считаются только успешные; возраст — от старта сессии, не от последнего тёрна.
# 0 или меньше выключает порог. При ротации история уезжает в state/archive/.
BUTLER_SESSION_MAX_TURNS=40
BUTLER_SESSION_MAX_AGE_H=48
# Распознавание речи. Пустой язык или словарь = параметр не уходит в запрос (автоопределение).
# Словарь действует только на Groq: фолбэк OpenRouter по контракту провайдера принимает
# prompt и игнорирует его, поэтому туда он не отправляется. Язык работает у обоих.
BUTLER_STT_LANGUAGE=ru
BUTLER_STT_PROMPT=Термины пайплайна: issue, sprint, спринт, карта, Kanboard, Codex, Claude, deploy, CI, PR, merge, worktree, plane, джетбрейнс, бэкенд, фронтенд, Ummanu, дворецкий.
BUTLER_STT_GROQ_MODEL=whisper-large-v3-turbo
BUTLER_STT_OPENROUTER_MODEL=openai/whisper-large-v3-turbo
